{
  "name": "dsh-archived-chats",
  "version": "0.11.0",
  "description": "DeepSeek Harness 本地归档会话中心：全文搜索、回收站、撤销、自动保护快照与备份恢复。Local archived-chat search, recycle bin, undo, automatic protection snapshots, and backup restore for DeepSeek Harness.",
  "license": "MIT",
  "author": "Ultronen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ultronen/dsh-archived-chats.git"
  },
  "homepage": "https://github.com/Ultronen/dsh-archived-chats",
  "bugs": {
    "url": "https://github.com/Ultronen/dsh-archived-chats/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "archive",
    "backup",
    "recycle-bin",
    "undo",
    "snapshot",
    "full-text-search",
    "local-first",
    "conversation-search",
    "sessions",
    "web-ui"
  ],
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/trash.js",
    "lib/snapshot.js",
    "lib/export.js",
    "lib/import.js",
    "lib/metadata.js",
    "lib/restore.js",
    "lib/recycle.js",
    "lib/insights.js",
    "lib/retention.js",
    "lib/retention-service.js",
    "lib/lineage.js",
    "lib/search.js",
    "lib/stats.js",
    "lib/types",
    "docs/ARCHITECTURE.md",
    "docs/ARCHITECTURE.en.md",
    "assets/screenshots",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0"
  },
  "dependencies": {
    "@deepseek-ai/dsh-session": "^0.1.0-rc.7",
    "fflate": "^0.8.3",
    "zip-stream": "^7.0.5"
  }
}
