{
  "name": "dsh-archived-chats",
  "version": "0.9.0",
  "description": "DeepSeek Harness 已归档会话管理页：搜索、标签、备份恢复，以及 Codex/Claude Code JSONL 迁移。Archived Chats management with backup restore and Codex/Claude Code JSONL migration.",
  "license": "MIT",
  "author": "Ultronen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ultronen/dsh-archived-chats.git"
  },
  "homepage": "https://github.com/Ultronen/dsh-archived-chats",
  "bugs": {
    "url": "https://github.com/Ultronen/dsh-archived-chats/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "archive",
    "codex",
    "claude-code",
    "chat-migration",
    "sessions",
    "web-ui"
  ],
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/export.js",
    "lib/import.js",
    "lib/metadata.js",
    "lib/restore.js",
    "lib/stats.js",
    "lib/interop",
    "lib/types",
    "assets/screenshots",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0"
  },
  "dependencies": {
    "@deepseek-ai/dsh-session": "^0.1.0-rc.7",
    "fflate": "^0.8.3",
    "zip-stream": "^7.0.5"
  }
}
