{
  "name": "dsh-archived-chats",
  "version": "1.3.2",
  "description": "DeepSeek Harness 会话档案：从设置中安全归档工作区会话，按工作区浏览和全文搜索归档聊天，原生只读预览对话、工具活动和已存储图片，管理标签备注与 ZIP 备份恢复；提供统一回收站、可选自动清理、空间分账和来源与分支，已有快照直接进入回收站。所有数据留在本机。 Session Archive for DeepSeek Harness: safely archive workspace chats from Settings; browse and full-text search archived chats; preview conversations, tool activity, and stored images read-only; manage tags, notes, and ZIP backup restore; provide a unified Recycle Bin, optional automatic cleanup, storage accounting, and Origins & Branches, with existing snapshots shown directly in the Recycle Bin. All data stays local.",
  "license": "MIT",
  "author": "Ultronen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ultronen/dsh-archived-chats.git"
  },
  "homepage": "https://github.com/Ultronen/dsh-archived-chats",
  "bugs": {
    "url": "https://github.com/Ultronen/dsh-archived-chats/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "archive",
    "backup",
    "recycle-bin",
    "undo",
    "snapshot",
    "retention",
    "storage-insights",
    "session-lineage",
    "full-text-search",
    "local-first",
    "conversation-search",
    "sessions",
    "web-ui"
  ],
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "screenshots.json",
    "lib/index.js",
    "lib/client.js",
    "lib/trash.js",
    "lib/snapshot.js",
    "lib/export.js",
    "lib/import.js",
    "lib/metadata.js",
    "lib/durable.js",
    "lib/restore.js",
    "lib/recycle.js",
    "lib/insights.js",
    "lib/retention.js",
    "lib/auto-retention.js",
    "lib/retention-service.js",
    "lib/lineage.js",
    "lib/workspace-bulk-archive.js",
    "lib/persistence-compat.js",
    "lib/search.js",
    "lib/stats.js",
    "lib/types",
    "docs/ARCHITECTURE.md",
    "docs/ARCHITECTURE.en.md",
    "assets/brand",
    "assets/screenshots",
    "cordis.patch.yml"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.1.0-rc.7"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.7 <0.1.1-0 || >=0.1.1-rc.1 <0.1.2-0 || >=0.1.2-alpha.1 <0.2.0-0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-session": {
      "optional": true
    }
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "zip-stream": "^7.0.5"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "typescript": "^5.9.3"
  }
}
